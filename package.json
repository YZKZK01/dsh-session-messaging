{
  "name": "@zlzlk/dsh-session-messaging",
  "description": "基于 tonyzdev/dsh-session-messaging v0.3.2（MIT，作者 tonyzdev）的发布分支：顶层会话之间互相发消息、开新会话交代任务",
  "version": "0.2.0",
  "author": "tonyzdev",
  "license": "MIT",
  "icon": "./icon.svg",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "LICENSE",
    "COMPATIBILITY.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-chat"
      ]
    }
  },
  "engines": {
    "dsh": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "session-messaging",
    "cross-session",
    "multi-agent",
    "agent-collaboration"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YZKZK01/dsh-session-messaging.git"
  },
  "homepage": "https://github.com/YZKZK01/dsh-session-messaging#readme",
  "bugs": {
    "url": "https://github.com/YZKZK01/dsh-session-messaging/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
